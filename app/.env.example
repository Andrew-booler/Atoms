# Atoms Studio 后端 AI 配置示例
# 用法：复制为 .env 后填写；.env 已被 .gitignore 忽略，切勿把真实密钥提交到版本库。
# 安全约定：密钥只经环境变量注入，代码与日志只记录供应商名 / 模型 / 错误类型，不打印密钥。

# ==== 供应商优先级：主选 → 备选 → 兜底（逗号分隔；缺失 API key 的家会自动跳过该级） ====
APP_AI_PROVIDER_ORDER=aliyun,ark,zhipu

# ==== 1) 阿里百炼（主选，OpenAI 兼容） ====
# 注意：公共 dashscope 域名与「工作区专属 MaaS」域名不是同一套模型权限，
# 不可混用；若模型在公共域名下报 AccessDenied.Unpurchased，请改用 MaaS 域名。
# 北京站 · 工作区 MaaS（推荐，模型权限跟随工作区）：
#   https://ws-<工作区ID>.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# 北京站 · 公共服务：https://dashscope.aliyuncs.com/compatible-mode/v1
# 国际/新加坡站：    https://dashscope-intl.aliyuncs.com/compatible-mode/v1
APP_AI_ALIYUN_BASE_URL=https://ws-8mf1tjg3auks3710.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
APP_AI_ALIYUN_API_KEY=
APP_AI_ALIYUN_MODEL=qwen3.8-flash
# 可选：开启 thinking（extra_body={"enable_thinking": true}）。当前默认关闭，且 aihub 未透传该参数；
# 如需开启需扩展 aihub 的请求体。关闭原因：reasoning 会占用 max_tokens 预算，长 HTML 生成有截断风险。
# APP_AI_ALIYUN_MAX_TOKENS=
# APP_AI_ALIYUN_MAX_CONCURRENCY=2
# APP_AI_ALIYUN_TIMEOUT=60

# ==== 2) 火山方舟（备选，OpenAI 兼容 v3） ====
# 北京站（默认）：https://ark.cn-beijing.volces.com/api/v3
# 方舟 model 填「推理接入点 ID（ep-xxxxxxxx）」或「模型 ID（如 doubao-...）」；
# 无默认值，必须显式填写，否则该供应商会被自动跳过。
APP_AI_ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
APP_AI_ARK_API_KEY=
APP_AI_ARK_MODEL=
# APP_AI_ARK_MAX_TOKENS=
# APP_AI_ARK_MAX_CONCURRENCY=2
# APP_AI_ARK_TIMEOUT=60

# ==== 3) 智谱 GLM（最后兜底） ====
# 兼容历史单一配置：不填 ZHIPU_* 时回退读取 APP_AI_BASE_URL / APP_AI_KEY。
APP_AI_ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
APP_AI_ZHIPU_API_KEY=
APP_AI_ZHIPU_MODEL=glm-4.7-flash
# APP_AI_ZHIPU_MAX_TOKENS=
# APP_AI_ZHIPU_MAX_CONCURRENCY=2
# APP_AI_ZHIPU_TIMEOUT=60

# ==== 全局韧性（各家独立重试计数 / 独立并发信号量；以下为默认值） ====
# APP_AI_MAX_RETRIES=4
# APP_AI_RETRY_BASE=1.0
# APP_AI_RETRY_MAX=30.0
# APP_AI_MAX_CONCURRENCY=2
