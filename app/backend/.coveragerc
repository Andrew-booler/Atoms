[run]
branch = True
omit =
    # 固定数据、模型配置与诊断（无业务分支）
    */mock_data.py
    */studio_ai.py
    */config.py
    */enums.py
    */telemetry/*
    */__init__.py
    # 模板旁路能力：产品暂未使用，暂不列入测试（见 docs/后端测试设计与用例.md §5）
    */aihub.py
    */aihub_errors.py
    */user.py
    */storage.py
    */projects.py
    */studio_messages.py
    */studio_versions.py

[report]
# 覆盖率门禁（P0 横切补强）：沿用既有 75% 口径，排除名单保持不变。
fail_under = 75
exclude_lines =
    pragma: no cover
    if TYPE_CHECKING:
    if __name__ == .__main__.:
